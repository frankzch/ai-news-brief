# LLM (any OpenAI-compatible API; DeepSeek by default)
DEEPSEEK_API_KEY=""
INBRIEF_LLM_API_KEY=""   # fallback if DEEPSEEK_API_KEY unset
INBRIEF_LLM_BASE_URL="https://api.deepseek.com/v1"

# Database — any PostgreSQL with the pgvector extension (Supabase free tier works)
INBRIEF_SUPABASE_DB_URL="postgresql://user:password@host:port/database"

# Aliyun Content Security (Green) — optional pre-filter before articles are stored.
# Leave empty to skip moderation entirely.
INBRIEF_ALIYUN_AK=""
INBRIEF_ALIYUN_SK=""
# INBRIEF_GREEN_ENDPOINT="green-cip.cn-shanghai.aliyuncs.com"
# INBRIEF_GREEN_SERVICE="chat_detection"

# GitHub (optional, for higher API rate limits: 60/h → 5000/h)
GITHUB_TOKEN=""

# Reddit cookies as a JSON array (optional; alternative to the Playwright profile login)
# REDDIT_COOKIES=""
